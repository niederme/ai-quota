    "One usage alert per window at your threshold. On Mac, alerts follow the original connection for each service." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Nutzungshinweis pro Zeitfenster bei deinem Schwellenwert. Auf dem Mac folgen Hinweise der ursprünglichen Verbindung jedes Dienstes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aviso de uso por ventana al llegar a tu umbral. En el Mac, los avisos siguen la conexión original de cada servicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une alerte d’utilisation par fenêtre à votre seuil. Sur Mac, les alertes suivent la connexion d’origine de chaque service."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しきい値に達すると、枠ごとに1回使用量アラートを送信します。Macでは、アラートは各サービスの元の接続に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기간마다 임계값에 도달하면 사용량 알림을 한 번 보냅니다. Mac에서는 서비스별 원래 연결을 기준으로 알림을 보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um alerta de uso por janela no seu limiar. No Mac, os alertas seguem a conexão original de cada serviço."
          }
        }
      }
    },
    "One usage alert per window when usage reaches your threshold. Reset reminders are separate. On Mac, alerts follow the original connection for each service." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Nutzungshinweis pro Zeitfenster, wenn die Nutzung deinen Schwellenwert erreicht. Reset-Erinnerungen sind davon getrennt. Auf dem Mac folgen Hinweise der ursprünglichen Verbindung jedes Dienstes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aviso de uso por ventana cuando el uso alcanza tu umbral. Los recordatorios de reinicio son independientes. En el Mac, los avisos siguen la conexión original de cada servicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une alerte d’utilisation par fenêtre quand l’utilisation atteint votre seuil. Les rappels de réinitialisation sont distincts. Sur Mac, les alertes suivent la connexion d’origine de chaque service."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用量がしきい値に達すると、枠ごとに1回使用量アラートを送信します。リセットリマインダーは別に設定します。Macでは、アラートは各サービスの元の接続に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용량이 임계값에 도달하면 기간마다 사용량 알림을 한 번 보냅니다. 초기화 알림은 별도입니다. Mac에서는 서비스별 원래 연결을 기준으로 알림을 보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um alerta de uso por janela quando o uso atinge seu limiar. Os lembretes de renovação são separados. No Mac, os alertas seguem a conexão original de cada serviço."
          }
        }
      }
    },
    "One usage alert per window, at or above this threshold. Enter 5 to 100 percent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Nutzungshinweis pro Zeitfenster, ab diesem Schwellenwert. Gib 5 bis 100 Prozent ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aviso de uso por ventana, al alcanzar o superar este umbral. Introduce un valor del 5 al 100 por ciento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une alerte d’utilisation par fenêtre, à partir de ce seuil. Saisissez une valeur de 5 à 100 pour cent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このしきい値以上になると、枠ごとに1回使用量アラートを送信します。5〜100パーセントで入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용량이 이 임계값 이상이 되면 기간마다 알림을 한 번 보냅니다. 5~100퍼센트 사이로 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um alerta de uso por janela, no limiar ou acima dele. Digite de 5 a 100 por cento."
          }
