    "Drag account cards in the menu bar popover to change their order. Open an account to manage its connection and menu bar gauge." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe Account-Karten im Menüleisten-Popover, um ihre Reihenfolge zu ändern. Öffne einen Account, um seine Verbindung und seine Menüleistenanzeige zu verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra las tarjetas de cuenta en el panel de la barra de menús para cambiar su orden. Abre una cuenta para gestionar su conexión y su indicador en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les cartes de compte dans la fenêtre de la barre des menus pour changer leur ordre. Ouvrez un compte pour gérer sa connexion et sa jauge dans la barre des menus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーのポップオーバーでアカウントカードをドラッグすると、順番を変更できます。アカウントを開くと、接続とメニューバーのゲージを管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 팝오버에서 계정 카드를 드래그하여 순서를 변경하세요. 계정을 열면 연결 및 메뉴 막대 게이지를 관리할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste os cartões de conta no painel da barra de menus para mudar a ordem. Abra uma conta para gerenciar a conexão e o medidor na barra de menus."
          }
        }
      }
