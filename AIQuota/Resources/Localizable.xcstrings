          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wirst du von allen Accounts abgemeldet, zwischengespeicherte Daten werden gelöscht und die Standardeinstellungen wiederhergestellt. Die Mitteilungsberechtigungen im System bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará la sesión de todas las cuentas, se borrarán los datos en caché y se restaurarán los ajustes por omisión. Los permisos de notificación del sistema no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action vous déconnecte de tous les comptes, efface les données en cache et rétablit les réglages par défaut. Les autorisations de notification du système ne changent pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアカウントからサインアウトし、キャッシュされたデータを消去して、デフォルト設定に戻します。システムの通知許可は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 계정에서 로그아웃하고, 캐시된 데이터를 지우고, 기본 설정으로 복원합니다. 시스템 알림 권한은 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto finaliza a sessão em todas as contas, apaga os dados em cache e restaura os ajustes padrão. As permissões de notificação do sistema não mudam."
          }
        }
      }
    },
