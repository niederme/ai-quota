        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIQuota suma los eventos de créditos de uso de %@ y los convierte a razón de 25 créditos = 1 $."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIQuota additionne les crédits d’utilisation de %@ et les convertit à raison de 25 crédits = 1 $."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
