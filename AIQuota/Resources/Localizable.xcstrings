    "Share app launches, active use, setup completion, and app version. No prompts, tokens, cookies, or personal info." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt App-Starts, aktive Nutzung, abgeschlossene Einrichtung und App-Version. Keine Prompts, Tokens, Cookies oder persönlichen Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte los inicios de la app, el uso activo, si se completó la configuración y la versión de la app. Sin prompts, tokens, cookies ni información personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partage les ouvertures de l’app, l’utilisation active, la fin de la configuration et la version de l’app. Aucun prompt, jeton, cookie ni info personnelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの起動、利用状況、設定の完了、アプリのバージョンを共有します。プロンプト、トークン、Cookie、個人情報は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 실행, 실제 사용, 설정 완료 여부 및 앱 버전을 공유합니다. 프롬프트, 토큰, 쿠키 또는 개인정보는 포함되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilha aberturas do app, uso ativo, conclusão da configuração e versão do app. Nenhum prompt, token, cookie ou informação pessoal."
          }
        }
      }
    },
