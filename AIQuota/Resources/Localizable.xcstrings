    "Estimate from current quota usage and available service history. Changes in usage can change the forecast." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schätzung aus der aktuellen Kontingentnutzung und dem verfügbaren Dienstverlauf. Änderungen der Nutzung können die Prognose verändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimación a partir del uso actual de la cuota y del historial disponible del servicio. Los cambios en el uso pueden cambiar la previsión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimation fondée sur l’utilisation actuelle du quota et l’historique disponible du service. Une variation de l’utilisation peut modifier la prévision."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のクォータの使用量と、利用可能なサービス履歴に基づく推定です。使用量が変わると予測も変わることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 사용량과 서비스 기록을 바탕으로 한 추정치입니다. 사용량이 바뀌면 예측도 달라질 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa com base no uso atual da cota e no histórico disponível do serviço. Mudanças no uso podem alterar a previsão."
          }
        }
      }
    },
