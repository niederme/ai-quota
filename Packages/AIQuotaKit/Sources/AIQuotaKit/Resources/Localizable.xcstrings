    "Your %@ 5-hour window has reset. You're back to full capacity." : {
      "comment" : "Notification body. The value is the account name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein 5-Stunden-Fenster für %@ wurde zurückgesetzt. Dir steht wieder das volle Kontingent zur Verfügung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana de 5 horas de %@ se ha reiniciado. Vuelves a tener toda la capacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre de 5 heures de %@ a été réinitialisée. Vous disposez à nouveau de toute votre capacité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の5時間枠がリセットされました。再びすべて使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 5시간 기간이 초기화되었습니다. 사용 한도가 모두 복구되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: sua janela de 5 horas foi renovada. Você voltou à capacidade total."
          }
        }
      }
    },
