    "Start a fresh sign-in without changing your saved connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte eine neue Anmeldung, ohne deine gespeicherte Verbindung zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión de nuevo sin cambiar la conexión guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommencez la procédure de connexion sans modifier la connexion enregistrée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの接続を変更せずに、新しくサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 연결을 변경하지 않고 새로 로그인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie uma nova sessão sem alterar sua conexão salva."
          }
        }
      }
    },
    "That sign-in is for a different account than the one saved here, so nothing changed. Reconnect with the original account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anmeldung gehört zu einem anderen Account als dem hier gespeicherten, daher wurde nichts geändert. Verbinde dich erneut mit dem ursprünglichen Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese inicio de sesión corresponde a una cuenta distinta de la guardada aquí, así que no se ha cambiado nada. Vuelve a conectar con la cuenta original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion correspond à un autre compte que celui enregistré ici, donc rien n’a changé. Reconnectez-vous avec le compte d’origine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのサインインはここに保存されているものとは別のアカウントのため、何も変更されていません。元のアカウントで再接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 로그인은 여기에 저장된 계정과 다른 계정이므로 아무것도 변경되지 않았습니다. 원래 계정으로 다시 연결하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa sessão é de uma conta diferente da salva aqui, então nada mudou. Reconecte com a conta original."
          }
        }
      }
    },
    "The browser session changed while we were checking it. Click Check sign-in again, or try another account. Your saved connection hasn’t changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Browsersitzung hat sich während der Prüfung geändert. Klicke erneut auf „Anmeldung prüfen“ oder verwende einen anderen Account. Deine gespeicherte Verbindung wurde nicht geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión del navegador ha cambiado mientras la comprobábamos. Vuelve a hacer clic en Comprobar inicio de sesión o prueba con otra cuenta. Tu conexión guardada no ha cambiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session du navigateur a changé pendant la vérification. Cliquez à nouveau sur Vérifier la connexion ou essayez un autre compte. Votre connexion enregistrée n’a pas changé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認中にブラウザのセッションが変わりました。もう一度「サインインを確認」をクリックするか、別のアカウントを試してください。保存済みの接続は変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인하는 동안 브라우저 세션이 변경되었습니다. ‘로그인 확인’을 다시 클릭하거나 다른 계정으로 시도하세요. 저장된 연결은 변경되지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão do navegador mudou enquanto a verificávamos. Clique em Verificar Sessão de novo ou tente outra conta. Sua conexão salva não mudou."
          }
        }
      }
    },
    "The service didn’t recognize this account (error %lld). Try reconnecting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst hat diesen Account nicht erkannt (Fehler %lld). Versuche, ihn erneut zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio no ha reconocido esta cuenta (error %lld). Prueba a volver a conectarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service n’a pas reconnu ce compte (erreur %lld). Essayez de le reconnecter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスがこのアカウントを認識しませんでした（エラー%lld）。再接続してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스에서 이 계정을 인식하지 못했습니다(오류 %lld). 다시 연결해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço não reconheceu esta conta (erro %lld). Tente reconectar."
          }
        }
      }
    },
    "The service had a problem (error %lld). AIQuota will try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Dienst ist ein Problem aufgetreten (Fehler %lld). AIQuota versucht es erneut."
          }
        },
        "es" : {
