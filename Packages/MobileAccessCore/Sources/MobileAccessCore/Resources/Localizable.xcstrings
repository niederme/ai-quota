  "strings" : {
    "%@ is overpacing the %@ limit" : {
      "comment" : "Forecast title. First value is the account name, second a window key such as “5h”, “7d”, “30d” or the word “monthly”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ liegt über dem Tempo für das Limit (%2$@)"
