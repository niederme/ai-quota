    "Claude %@ failed (HTTP %lld). Try again. Your last reading is saved." : {
      "comment" : "Error. First value is a step such as “sign-in” or “usage update”, second an HTTP status code.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude: %1$@ fehlgeschlagen (HTTP %2$lld). Versuche es erneut. Dein letzter Messwert ist gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Claude %1$@ failed (HTTP %2$lld). Try again. Your last reading is saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude: ha fallado %1$@ (HTTP %2$lld). Inténtalo de nuevo. Tu última lectura está guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude : échec %1$@ (HTTP %2$lld). Réessayez. Votre dernier relevé est conservé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claudeの%1$@に失敗しました（HTTP %2$lld）。やり直してください。前回のデータは保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude %1$@ 실패(HTTP %2$lld). 다시 시도하세요. 마지막 수치는 저장되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude: %1$@ falhou (HTTP %2$lld). Tente novamente. Sua última leitura está salva."
          }
        }
      }
    },
    "Claude could not renew this sign-in. Reconnect Claude to continue. Your last reading is saved." : {
      "comment" : "Error.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude konnte diese Anmeldung nicht erneuern. Verbinde Claude erneut, um fortzufahren. Dein letzter Messwert ist gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude no ha podido renovar este inicio de sesión. Vuelve a conectar Claude para continuar. Tu última lectura está guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude n’a pas pu renouveler cette connexion. Reconnectez Claude pour continuer. Votre dernier relevé est conservé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claudeはこのサインインを更新できませんでした。続けるにはClaudeを再接続してください。前回のデータは保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude 로그인을 갱신할 수 없습니다. 계속하려면 Claude를 다시 연결하세요. 마지막 수치는 저장되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude não conseguiu renovar esta sessão. Reconecte o Claude para continuar. Sua última leitura está salva."
          }
        }
      }
    },
    "Claude is temporarily limiting updates. Updates are paused for a few minutes. Your last reading is saved." : {
      "comment" : "Error.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude begrenzt vorübergehend Updates. Updates sind für ein paar Minuten pausiert. Dein letzter Messwert ist gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude está limitando temporalmente las actualizaciones. Se han pausado durante unos minutos. Tu última lectura está guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude limite temporairement les mises à jour. Elles sont suspendues pendant quelques minutes. Votre dernier relevé est conservé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claudeが一時的に更新を制限しています。数分間、更新を一時停止します。前回のデータは保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude가 일시적으로 업데이트를 제한하고 있습니다. 몇 분 동안 업데이트가 일시 정지됩니다. 마지막 수치는 저장되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude está limitando as atualizações temporariamente. Elas ficam pausadas por alguns minutos. Sua última leitura está salva."
          }
        }
      }
    },
    "Claude sign-in renewal failed (HTTP %@). Retry or reconnect Claude. Your last reading is saved." : {
      "comment" : "Error. The value is an HTTP status code, sometimes followed by the provider's own reason in English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneuerung der Claude-Anmeldung fehlgeschlagen (HTTP %@). Versuche es erneut oder verbinde Claude erneut. Dein letzter Messwert ist gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha fallado la renovación del inicio de sesión de Claude (HTTP %@). Reintenta o vuelve a conectar Claude. Tu última lectura está guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude : échec du renouvellement de la connexion (HTTP %@). Réessayez ou reconnectez Claude. Votre dernier relevé est conservé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claudeのサインインの更新に失敗しました（HTTP %@）。再試行するか、Claudeを再接続してください。前回のデータは保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude 로그인 갱신 실패(HTTP %@). 재시도하거나 Claude를 다시 연결하세요. 마지막 수치는 저장되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A renovação da sessão do Claude falhou (HTTP %@). Tente de novo ou reconecte o Claude. Sua última leitura está salva."
          }
        }
      }
    },
