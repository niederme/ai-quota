          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is overpacing the %2$@ limit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ va demasiado rápido para el límite %2$@"
          }
        },
