  "strings" : {
    "%@ is overpacing the %@ limit" : {
      "comment" : "Forecast title. First value is the account name, second a window key such as “5h”, “7d”, “30d” or the word “monthly”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is overpacing the %2$@ limit"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Monthly spend budget, such as “$654.98 of $1,000”. Values are formatted currency amounts.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        }
      }
    },
