    "Two accounts in one card, with allowance details and available history. Follows your selected account order." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Accounts in einer Karte, mit Kontingentdetails und verfügbarem Verlauf. Folgt deiner gewählten Account-Reihenfolge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos cuentas en una tarjeta, con detalles de la cuota e historial disponible. Sigue el orden de cuentas seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux comptes sur une carte, avec les détails du quota et l’historique disponible. Suit l’ordre des comptes sélectionné."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1枚のカードに2つのアカウントを、利用枠の詳細と利用可能な履歴とともに表示します。選択したアカウントの順番に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 카드에 두 계정의 사용 한도 세부 정보와 기록을 표시합니다. 선택한 계정 순서를 따릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas contas em um cartão, com detalhes da cota e histórico disponível. Segue a ordem de contas selecionada."
          }
        }
      }
    },
