    "You can add accounts or services later in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Accounts oder Dienste später in den Einstellungen hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes añadir cuentas o servicios más tarde en Ajustes."
          }
        },
        "fr" : {
