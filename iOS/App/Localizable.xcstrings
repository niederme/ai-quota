    "Tap a day to see its reported usage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Tag, um seine gemeldete Nutzung zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un día para ver su uso registrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un jour pour voir son utilisation communiquée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付をタップすると、報告された使用量が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜를 탭하면 해당 날의 사용량을 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um dia para ver o uso informado."
          }
        }
      }
    },
    "Tap a day to show its product amounts. A missing bar means no spend was reported for that day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Tag, um seine Produktbeträge anzuzeigen. Ein fehlender Balken bedeutet, dass für diesen Tag keine Ausgaben gemeldet wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un día para ver los importes por producto. Si falta una barra, no hay datos de gasto para ese día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un jour pour afficher ses montants par produit. Une barre manquante signifie qu’aucune dépense n’a été communiquée ce jour-là."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付をタップすると、製品別の金額が表示されます。バーがない日は、利用額が報告されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜를 탭하면 제품별 금액이 표시됩니다. 막대가 없으면 해당 날에 제공된 지출이 없다는 뜻입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um dia para ver os valores por produto. Uma barra ausente significa que nenhum gasto foi informado nesse dia."
          }
        }
      }
    },
    "Tap Add Widgets, choose AIQuota, then tap Done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Widgets hinzufügen“, wähle AIQuota und tippe dann auf „Fertig“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
