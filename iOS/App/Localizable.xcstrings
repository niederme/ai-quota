    "Signs out of all accounts and resets settings to defaults." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet dich von allen Accounts ab und setzt die Einstellungen auf die Standardwerte zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la sesión de todas las cuentas y restablece los ajustes por omisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnecte tous les comptes et rétablit les réglages par défaut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアカウントからサインアウトし、設定をデフォルトに戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 계정에서 로그아웃하고 설정을 기본값으로 재설정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finaliza a sessão em todas as contas e restaura os ajustes padrão."
          }
        }
      }
    },
    "Signs out of all services, clears cached data, and resets settings to defaults. System notification permissions are not affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet dich von allen Diensten ab, löscht zwischengespeicherte Daten und setzt die Einstellungen auf die Standardwerte zurück. Die Mitteilungsberechtigungen im System sind nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la sesión de todos los servicios, borra los datos en caché y restablece los ajustes por omisión. No afecta a los permisos de notificación del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnecte tous les services, efface les données en cache et rétablit les réglages par défaut. Les autorisations de notification du système ne sont pas modifiées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのサービスからサインアウトし、キャッシュされたデータを消去して、設定をデフォルトに戻します。システムの通知許可は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 서비스에서 로그아웃하고, 캐시된 데이터를 지우고, 설정을 기본값으로 재설정합니다. 시스템 알림 권한에는 영향을 주지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finaliza a sessão em todos os serviços, apaga os dados em cache e restaura os ajustes padrão. As permissões de notificação do sistema não são afetadas."
          }
        }
      }
    },
