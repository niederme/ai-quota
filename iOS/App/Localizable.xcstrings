        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude 로그인이 만료되었습니다. 계속하려면 다시 연결하세요. 마지막 수치는 저장되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão do Claude expirou. Reconecte para continuar. Sua última leitura está salva."
          }
