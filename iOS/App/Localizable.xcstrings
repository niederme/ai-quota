    "Weekly breakdown unavailable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wöchentliche Aufschlüsselung nicht verfügbar"
          }
        },
        "es" : {
