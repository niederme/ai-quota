          }
        }
      }
    },
    "Claude requires a web sign-in for Enterprise spend and skills. Sign in to show those details? Cancel keeps your connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude erfordert eine Web-Anmeldung für Enterprise-Ausgaben und Skills. Anmelden, um diese Details anzuzeigen? „Abbrechen“ behält deine Verbindung bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude requiere iniciar sesión en la web para el gasto y las habilidades de Enterprise. ¿Iniciar sesión para mostrar esos detalles? Cancelar mantiene tu conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude requiert une connexion web pour les dépenses et compétences Enterprise. Voulez-vous vous connecter pour afficher ces détails ? Annuler conserve votre connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enterpriseの利用額とスキルを表示するには、Claudeのウェブでのサインインが必要です。サインインして詳細を表示しますか?「キャンセル」を選ぶと現在の接続が維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enterprise 지출과 스킬을 보려면 Claude 웹 로그인이 필요합니다. 로그인하여 세부 정보를 표시하겠습니까? ‘취소’를 누르면 연결이 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude exige um início de sessão na web para gastos e habilidades do Enterprise. Iniciar sessão para mostrar esses detalhes? Cancelar mantém sua conexão."
          }
        }
      }
    },
    "Claude sign-in couldn't load here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
