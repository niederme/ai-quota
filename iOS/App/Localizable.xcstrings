    "Your account is connected. Save the suggested name or choose your own. You can change it later in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Account ist verbunden. Sichere den vorgeschlagenen Namen oder wähle einen eigenen. Du kannst ihn später in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta está conectada. Guarda el nombre sugerido o elige uno propio. Puedes cambiarlo más tarde en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte est connecté. Enregistrez le nom proposé ou choisissez le vôtre. Vous pourrez le modifier plus tard dans Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントが接続されました。提案された名前を保存するか、独自の名前を付けてください。あとで設定から変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정이 연결되었습니다. 추천 이름을 저장하거나 직접 이름을 정하세요. 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta está conectada. Salve o nome sugerido ou escolha o seu. Você pode mudá-lo depois nos Ajustes."
          }
        }
      }
    },
    "Your last reading reported a reset now. Open AIQuota to check current usage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein letzter Messwert meldet jetzt einen Reset. Öffne AIQuota, um die aktuelle Nutzung zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu última lectura indicaba un reinicio ahora. Abre AIQuota para comprobar el uso actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dernier relevé indiquait une réinitialisation maintenant. Ouvrez AIQuota pour vérifier l’utilisation actuelle."
