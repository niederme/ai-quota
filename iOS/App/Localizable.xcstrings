          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Ajouter des widgets, choisissez AIQuota, puis touchez OK."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
