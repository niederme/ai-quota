    "Claude sign-in expired. Reconnect to continue. Your last reading is saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude-Anmeldung abgelaufen. Verbinde dich erneut, um fortzufahren. Dein letzter Messwert ist gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
