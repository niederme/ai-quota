        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 수치에 따르면 지금 초기화되었습니다. 현재 사용량을 확인하려면 AIQuota를 여세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
